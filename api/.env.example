# Database (SQLite — zero external setup)
DATABASE_URL="file:./dev.db"

# Server
PORT=4000
# Comma-separated list of allowed CORS origins (web + admin dev servers)
CORS_ORIGINS="http://localhost:5173"

# Auth secrets — change these in production
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Seed admin credentials (used by prisma/seed.ts — password must be >= 12 chars)
SEED_ADMIN_EMAIL="admin@shraddhagarden.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-12+char-password"
